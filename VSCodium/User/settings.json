{
  // === EDITOR SETTINGS ===
  "editor.fontSize": 13,
  "editor.fontFamily": "'Hack Nerd Font', 'monospace', monospace",
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.rulers": [
    80
  ],
  "editor.renderWhitespace": "trailing",
  // Editor Formatting & Indentation
  "editor.detectIndentation": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "editor.formatOnSave": true,
  // Diff Editor Settings
  "diffEditor.ignoreTrimWhitespace": false,
  // === TERMINAL SETTINGS ===
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.initialHint": false,
  // === THEME & COLORS ===
  "workbench.preferredDarkColorTheme": "Gruvbox Dark Hard",
  "workbench.colorTheme": "Gruvbox Dark Hard",
  // Terminal Color Customizations (Gruvbox)
  "workbench.colorCustomizations": {
    "terminalCursor.background": "#282828",
    "terminalCursor.foreground": "#EBDBB2",
    "terminal.ansiBlack": "#282828",
    "terminal.ansiRed": "#CC241D",
    "terminal.ansiGreen": "#98971A",
    "terminal.ansiYellow": "#D79921",
    "terminal.ansiBlue": "#458588",
    "terminal.ansiMagenta": "#B16286",
    "terminal.ansiCyan": "#689D6A",
    "terminal.ansiWhite": "#A89984",
    "terminal.ansiBrightBlack": "#928374",
    "terminal.ansiBrightRed": "#FB4934",
    "terminal.ansiBrightGreen": "#B8BB26",
    "terminal.ansiBrightYellow": "#FABD2F",
    "terminal.ansiBrightBlue": "#83A598",
    "terminal.ansiBrightMagenta": "#D3869B",
    "terminal.ansiBrightCyan": "#8EC07C",
    "terminal.ansiBrightWhite": "#EBDBB2"
  },
  // === WORKBENCH/UI SETTINGS ===
  "workbench.startupEditor": "readme",
  "window.titleBarStyle": "native",
  "window.menuBarVisibility": "toggle",
  "window.customTitleBarVisibility": "never",
  // === GIT SETTINGS ===
  "git.openRepositoryInParentFolders": "always",
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  // === FILE ASSOCIATIONS ===
  "files.associations": {
    "*.dconf": "properties",
    "*.config": "properties",
    "*.toml": "properties",
    "*.kvconfig": "properties",
    "*.sh": "shellscript",
    "*.theme": "properties"
  },
  // === MISC SETTINGS ===
  "update.showReleaseNotes": false,
  "workbench.sideBar.location": "right"
}